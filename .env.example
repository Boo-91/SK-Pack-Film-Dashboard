# GEMINI_API_KEY: Optional (not required for the Google Sheets dashboard).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# GOOGLE_SHEET_URL: Full Google Sheet URL or Spreadsheet ID for automatic live syncing on Vercel.
# Example: 1dX0DCqeW-oASj4prccSmjlrDOpKl52NHs3HlvhJ3XBE
GOOGLE_SHEET_URL=""

# GOOGLE_SERVICE_ACCOUNT_JSON: Full contents of your Google Service Account JSON key file
# (or use GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY below).
# Allows Vercel to read private @dplusonline.net / organization sheets automatically with zero user login.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
